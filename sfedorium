#!/usr/bin/env python3
"""
Fedorium spinning logo — a 3D ASCII spinner in the spirit of donut.c.

The Fedorium logo (hexagon + fedora hat with a < > band) is turned into a
3D object with thickness, rotated, lit, and drawn with ASCII characters in
the logo's colours. Pure Python, no packages needed.

Run:   sfedorium
Stop:  Ctrl+C
"""
import math
import os
import shutil
import sys
import time

# ---------------------------------------------------------------- settings
STEP = 2.5            # sampling step in logo units (smaller = finer, slower)
FPS = 30              # target frames per second
SPIN_SPEED = 1.6      # radians per second around the vertical axis
CHARS = ".,-~:;=!*#$@"  # dark -> bright, like donut.c
SHOW_WORDMARK = True

# Logo colours (R, G, B)
COLORS = {
    1: (142, 201, 240),   # hexagon / band   (light blue)
    2: (60, 110, 180),    # crown / brim     (blue)
    3: (142, 201, 240),   # band
    4: (41, 65, 114),     # < > brackets     (navy)
    5: (60, 110, 180),    # brim
}
# Half-thickness of each part (bigger = sticks out more)
DEPTH = {1: 12, 2: 10, 3: 13, 4: 15, 5: 13}

# ---------------------------------------------------------------- 2D geometry (from fedorium-logo.svg)
HEX = [(200, 34), (344, 117), (344, 283), (200, 366), (56, 283), (56, 117)]


def quad(p0, p1, p2, n=10):
    return [((1 - t) ** 2 * p0[0] + 2 * (1 - t) * t * p1[0] + t * t * p2[0],
             (1 - t) ** 2 * p0[1] + 2 * (1 - t) * t * p1[1] + t * t * p2[1])
            for t in (i / n for i in range(n + 1))]


DY = 10  # the hat group is shifted down by 10 in the SVG
CROWN = ([(140, 226), (152, 142)] + quad((152, 142), (155, 128), (169, 131))
         + [(190, 139), (200, 151), (210, 139), (231, 131)]
         + quad((231, 131), (245, 128), (248, 142)) + [(260, 226)])
CROWN = [(x, y + DY) for x, y in CROWN]
BAND = [(144.5, 192 + DY), (255.5, 192 + DY), (259.3, 220 + DY), (140.7, 220 + DY)]
BRACKETS = [[(184, 197 + DY), (170, 206 + DY), (184, 215 + DY)],
            [(216, 197 + DY), (230, 206 + DY), (216, 215 + DY)]]
BRIM = (88, 234 + DY, 312, 258 + DY, 12)  # x0, y0, x1, y1, radius


def inside_poly(x, y, poly):
    hit = False
    j = len(poly) - 1
    for i in range(len(poly)):
        xi, yi = poly[i]
        xj, yj = poly[j]
        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi:
            hit = not hit
        j = i
    return hit


def seg_dist(px, py, ax, ay, bx, by):
    dx, dy = bx - ax, by - ay
    t = max(0.0, min(1.0, ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)))
    return math.hypot(px - (ax + t * dx), py - (ay + t * dy))


def polyline_dist(x, y, pts, closed=False):
    segs = list(zip(pts, pts[1:] + ([pts[0]] if closed else [])))
    return min(seg_dist(x, y, a[0], a[1], b[0], b[1]) for a, b in segs)


def in_round_rect(x, y, r):
    x0, y0, x1, y1, rad = r
    cx = min(max(x, x0 + rad), x1 - rad)
    cy = min(max(y, y0 + rad), y1 - rad)
    return math.hypot(x - cx, y - cy) <= rad


def region(x, y):
    """Which part of the logo covers this point (0 = empty)."""
    if inside_poly(x, y, BAND) and min(polyline_dist(x, y, b) for b in BRACKETS) <= 3.6:
        return 4
    if inside_poly(x, y, BAND):
        return 3
    if in_round_rect(x, y, BRIM):
        return 5
    if inside_poly(x, y, CROWN):
        return 2
    if polyline_dist(x, y, HEX, closed=True) <= 8:
        return 1
    return 0


# ---------------------------------------------------------------- build the 3D point cloud
def build_points():
    xs = [20 + i * STEP for i in range(int(360 / STEP) + 1)]
    grid = {}
    for gy, y in enumerate(xs):
        for gx, x in enumerate(xs):
            r = region(x, y)
            if r:
                grid[(gx, gy)] = r
    pts = []  # (x, y, z, nx, ny, nz, colour_id), centred on (200, 200)
    for (gx, gy), r in grid.items():
        x, y = xs[gx] - 200, xs[gy] - 200
        d = DEPTH[r]
        pts.append((x, y, -d, 0.0, 0.0, -1.0, r))   # front face
        pts.append((x, y, d, 0.0, 0.0, 1.0, r))     # back face
        # side walls where the neighbour is thinner (or empty)
        for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):
            nr = grid.get((gx + dx, gy + dy), 0)
            nd = DEPTH[nr] if nr else 0
            if nd >= d:
                continue
            z = nd
            while z <= d:
                for sz in (-1, 1):
                    pts.append((x + dx * STEP / 2, y + dy * STEP / 2, sz * z,
                                float(dx), float(dy), 0.0, r))
                z += STEP
    return pts


# ---------------------------------------------------------------- render loop
def main():
    if os.name == "nt":
        os.system("")  # enable ANSI colours on Windows terminals
    points = build_points()
    light = (-0.45, -0.55, -0.70)
    ln = math.sqrt(sum(c * c for c in light))
    lx, ly, lz = (c / ln for c in light)
    nchars = len(CHARS) - 1

    sys.stdout.write("\x1b[?25l\x1b[2J")  # hide cursor, clear screen
    start = time.time()
    try:
        while True:
            cols, rows = shutil.get_terminal_size((80, 40))
            rows -= 2 if SHOW_WORDMARK else 0
            w, h = cols, max(10, rows - 1)
            scale = min(h / 420, w / 2 / 420)  # terminal cells are ~2x taller than wide
            k2 = 700.0
            k1 = scale * k2
            cx, cy = w / 2, h / 2

            t = time.time() - start
            a = t * SPIN_SPEED                  # spin around the vertical axis
            b = 0.25 * math.sin(t * 0.7)        # gentle tilt forward / back
            ca, sa, cb, sb = math.cos(a), math.sin(a), math.cos(b), math.sin(b)

            zbuf = [0.0] * (w * h)
            out = [" "] * (w * h)
            col = [0] * (w * h)
            for x, y, z, nx, ny, nz, cid in points:
                # rotate around Y, then around X
                x1 = x * ca + z * sa
                z1 = -x * sa + z * ca
                y2 = y * cb - z1 * sb
                z2 = y * sb + z1 * cb
                ooz = 1.0 / (z2 + k2)
                sx = int(cx + k1 * x1 * ooz * 2)
                sy = int(cy + k1 * y2 * ooz)
                if not (0 <= sx < w and 0 <= sy < h):
                    continue
                i = sx + sy * w
                if ooz <= zbuf[i]:
                    continue
                # rotate the normal the same way and light it
                nx1 = nx * ca + nz * sa
                nz1 = -nx * sa + nz * ca
                ny2 = ny * cb - nz1 * sb
                nz2 = ny * sb + nz1 * cb
                if nz2 > 0.35:          # facing away from the viewer
                    continue
                lum = nx1 * lx + ny2 * ly + nz2 * lz
                lum = 0.08 if lum < 0.08 else lum
                zbuf[i] = ooz
                out[i] = CHARS[int(lum * nchars)]
                col[i] = cid * 16 + int(lum * 15)

            # build the frame with truecolour escapes
            lines = []
            for row in range(h):
                parts, last = [], None
                for c in range(w):
                    i = c + row * w
                    ch = out[i]
                    if ch == " ":
                        parts.append(" ")
                        continue
                    if col[i] != last:
                        last = col[i]
                        r, g, bl = COLORS[last // 16]
                        f = 0.35 + 0.65 * (last % 16) / 15
                        parts.append(f"\x1b[38;2;{int(r * f)};{int(g * f)};{int(bl * f)}m")
                    parts.append(ch)
                lines.append("".join(parts) + "\x1b[0m")
            if SHOW_WORDMARK:
                word = "fedor" + "\x1b[38;2;142;201;240mium"
                pad = " " * max(0, (w - 8) // 2)
                lines.append("")
                lines.append(pad + "\x1b[1;38;2;238;241;246m" + word + "\x1b[0m")
            sys.stdout.write("\x1b[H" + "\n".join(lines))
            sys.stdout.flush()

            spare = 1 / FPS - (time.time() - start - t)
            if spare > 0:
                time.sleep(spare)
    except KeyboardInterrupt:
        pass
    finally:
        sys.stdout.write("\x1b[0m\x1b[?25h\n")  # restore colours and cursor


if __name__ == "__main__":
    main()
